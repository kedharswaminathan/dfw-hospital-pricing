.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Secrets
.env
*.key

# Data files - never commit raw or processed data
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# DuckDB files anywhere in the project (safety net)
*.duckdb
*.duckdb.wal
*.duckdb.tmp