# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
.pytest_cache/

# Virtual environments
venv/
.venv/
env/

# Jupyter
.ipynb_checkpoints/

# Data — never commit raw data files
data/
*.duckdb
*.csv
*.parquet
*.json
